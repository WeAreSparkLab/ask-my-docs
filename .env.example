# Copy to .env.local (local dev) and set the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values.

# ---- Client (exposed to the browser; safe by design, protected by RLS) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Server only (Vercel serverless functions; never prefix with VITE_) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Used ONLY by scripts/ingest-corpus.ts run locally. Do NOT set this in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between /api and the `embed` Edge Function (generate: openssl rand -hex 32).
# Also set it in Supabase: `supabase secrets set EMBED_SECRET=...`
EMBED_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits (questions per hour)
RATE_LIMIT_DEMO_PER_IP=10
RATE_LIMIT_USER_PER_HOUR=30
